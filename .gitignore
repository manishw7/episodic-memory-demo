# Environments and secrets
.venv/
.env

# Local database and backups (never commit user conversations).
# The synthetic demo archive is the one exception: it contains no real user data and is
# committed so the demo looks identical on every machine.
*.db
!demo.db
*.db.bak
*.bak

# Runtime state and logs from start.sh / stop.sh
.run/

# Python / tooling caches
__pycache__/
*.py[cod]
.pytest_cache/

# macOS
.DS_Store
